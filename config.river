// 1. Accept OTLP data from the application
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.exporter.debug.console.input]
    logs    = [otelcol.exporter.loki.to_loki.input, otelcol.exporter.debug.console.input]
    traces  = [otelcol.exporter.otlp.to_tempo.input]
  }
}

// 2. The Debug Exporter (Now enabled via Docker flag)
otelcol.exporter.debug "console" {
  verbosity = "detailed"
}

// 3. Export Logs to Loki
otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
  external_labels = {
    job = "fastapi-app",
  }
}
// processing stage to extract the traceID from the text
loki.process "trace_correlation" {
  stage.regex {
    expression = "trace_id=(?P<trace_id>\\w+)"
  }
  stage.labels {
    values = {
      trace_id = "trace_id",
    }
  }
  forward_to = [loki.write.local.receiver]
}
// Update docker source to point to the process stage
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.container_logs.output
  forward_to = [loki.process.trace_correlation.receiver] // Connects to the correlation stage
}

// 4. Export Traces to Tempo
otelcol.exporter.otlp "to_tempo" {
  client {
    endpoint = "lgtm:4317"
    tls { insecure = true }
  }
}

// Metrics components removed/commented to clean up logs
