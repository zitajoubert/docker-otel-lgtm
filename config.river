
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.exporter.prometheus.to_mimir.input]
    logs    = [otelcol.exporter.loki.to_loki.input, otelcol.exporter.debug.console.input]
    traces  = [otelcol.exporter.otlp.to_tempo.input]
  }
}
otelcol.exporter.debug "console" {
  verbosity = "detailed"
}

otelcol.exporter.prometheus "to_mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint { url = "http://lgtm:9009/api/v1/push" }
}

otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
  external_labels = {
    job = "fastapi-app",
  }
}

otelcol.exporter.otlp "to_tempo" {
  client {
    endpoint = "lgtm:4317"
    tls { insecure = true }
  }
}